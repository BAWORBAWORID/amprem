<div class="app-layout" id="app-layout"><aside id="app-sidebar" class="app-sidebar hidden"><button id="btn-sidebar-close" class="sidebar-close-btn"><i class="fa-solid fa-xmark"></i></button><div class="sidebar-logo"><i class="fa-solid fa-cube logo-icon"></i><span>AM <span class="accent-text">CREATOR</span></span></div><nav class="sidebar-nav" id="nav-menu"><div class="nav-category">MENU UTAMA</div><button id="btn-dashboard-view" class="sidebar-link active"><i class="fa-solid fa-chart-simple"></i> Statistik Live</button><button id="btn-generator-view" class="sidebar-link"><i class="fa-solid fa-wand-magic-sparkles"></i> Create Account</button><button id="btn-netflix-view" class="sidebar-link"><i class="fa-solid fa-ticket" style="color: #e50914;"></i> Netflix Crack</button><button id="btn-history-view" class="sidebar-link"><i class="fa-solid fa-clock-rotate-left"></i> Riwayat Akun</button><div class="nav-category">LAYANAN & API</div><button id="btn-purchase-view" class="sidebar-link"><i class="fa-solid fa-qrcode"></i> Beli API Key</button><button id="btn-apiguide-view" class="sidebar-link"><i class="fa-solid fa-book"></i> Panduan API</button><button id="btn-chat-view" class="sidebar-link"><i class="fa-solid fa-comments"></i> Chat Global</button><div class="nav-category">AKUN & APLIKASI</div><button id="btn-profile-view" class="sidebar-link"><i class="fa-solid fa-user"></i> Profil</button><button id="btn-reviews-view" class="sidebar-link"><i class="fa-solid fa-star" style="color: #f59e0b;"></i> Rating & Ulasan</button><button id="btn-contributors-view" class="sidebar-link"><i class="fa-solid fa-users-gear"></i> Kontributor</button><a href="https://whatsapp.com/channel/0029Vb8EfuN35fM5AX25AT1W" target="_blank" class="sidebar-link" style="text-decoration: none; display: flex; align-items: center; gap: 10px; color: #25d366;"><i class="fa-brands fa-whatsapp"></i> Channel WhatsApp</a><a href="/alwayscodex.apk" download class="sidebar-link" style="text-decoration: none; display: flex; align-items: center; gap: 10px; color: #3b82f6;"><i class="fa-brands fa-android"></i> Download APK</a><div class="nav-category hidden" id="sidebar-admin-category">PENGATURAN ADMIN</div><button id="btn-admin-view" class="sidebar-link hidden"><i class="fa-solid fa-screwdriver-wrench"></i> Admin Panel</button><button id="btn-settings-view" class="sidebar-link hidden"><i class="fa-solid fa-gears"></i> Pengaturan Fitur</button><div class="nav-category">TEMA TAMPILAN</div><button id="btn-theme-toggle" class="sidebar-link"><i class="fa-solid fa-moon"></i> Mode Gelap</button></nav></aside><main class="main-content" id="main-content"><div class="mobile-top-bar hidden" id="mobile-top-bar"><button class="topbar-btn" id="btn-sidebar-toggle"><i class="fa-solid fa-bars"></i></button><div class="topbar-right"><button class="topbar-btn" id="btn-topbar-chat"><i class="fa-regular fa-comment-dots"></i><span class="topbar-badge"></span></button><div style="position: relative;"><button class="topbar-btn" id="btn-topbar-notifications"><i class="fa-regular fa-bell"></i><span class="topbar-badge" id="notifications-badge" style="display: none;"></span></button><div id="notifications-dropdown" class="notifications-dropdown hidden"><div class="notifications-header"><span>Pemberitahuan</span><button id="btn-clear-notifications" class="clear-all-btn">Hapus Semua</button></div><div class="notifications-list" id="notifications-list"></div></div></div><div class="topbar-avatar" id="btn-topbar-profile" style="cursor: pointer;"><i class="fa-regular fa-circle-user"></i></div></div></div><section id="screen-auth" class="screen hidden"><div class="auth-box glass-card animate-fade-in"><div id="auth-login-view"><h2 class="section-title">Sign In</h2><p class="section-subtitle">Akses Generator Alight Motion Premium</p><form id="form-login"><div class="input-group"><i class="fa-solid fa-envelope input-icon"></i><input type="text" id="login-username" placeholder="Username" required autocomplete="username"></div><div class="input-group"><i class="fa-solid fa-key input-icon"></i><input type="password" id="login-password" placeholder="Password" required autocomplete="current-password"></div><button type="submit" class="btn btn-primary btn-block btn-glow"><span>Login <i class="fa-solid fa-chevron-right"></i></span></button></form><p class="auth-toggle-text">Belum punya akun? <a href="#" id="link-to-register" class="link-accent">Daftar Akun</a></p></div><div id="auth-register-view" class="hidden"><h2 class="section-title">Sign Up</h2><p class="section-subtitle">Buat akun untuk mulai membuat lisensi premium</p><form id="form-register"><div class="input-group"><i class="fa-solid fa-envelope input-icon"></i><input type="text" id="register-username" placeholder="Username (Min 3 Karakter)" required autocomplete="username"></div><div class="input-group"><i class="fa-solid fa-key input-icon"></i><input type="password" id="register-password" placeholder="Password (Min 6 Karakter)" required autocomplete="new-password"></div><button type="submit" class="btn btn-primary btn-block btn-glow"><span>Daftar <i class="fa-solid fa-circle-check"></i></span></button></form><p class="auth-toggle-text">Sudah punya akun? <a href="#" id="link-to-login" class="link-accent">Login disini</a></p></div><div style="margin-top: 25px; border-top: 1px dashed var(--border-color); padding-top: 18px; text-align: center;"><a href="/alwayscodex.apk" download class="apk-download-btn-auth"><i class="fa-brands fa-android" style="font-size: 1.15rem;"></i><span>Unduh Aplikasi Android (.APK)</span></a></div></div></section><section id="screen-dashboard" class="screen hidden"><div class="dashboard-header animate-fade-in" style="margin-bottom: 28px; border-bottom: 1px solid var(--border-color); padding-bottom: 16px;"><h2 class="section-title" style="font-size: 1.85rem; display: flex; align-items: center; gap: 12px; margin: 0;"><i class="fa-solid fa-chart-line" style="color: var(--accent-primary);"></i> Dashboard</h2><p class="section-subtitle" style="margin-top: 6px; font-size: 0.88rem; line-height: 1.6; max-width: 700px; color: var(--text-secondary);">Pantau statistik aktivitas server, sisa saldo kredit, status runtime, dan informasi perangkat Anda secara real-time.</p></div><div class="apk-banner animate-fade-in"><div class="apk-banner-content"><div class="apk-banner-icon"><i class="fa-brands fa-android"></i></div><div><h4 class="apk-banner-title">Tersedia Aplikasi Android!</h4><p class="apk-banner-desc">Gunakan aplikasi Android resmi kami untuk akses yang lebih cepat, stabil, dan praktis.</p></div></div><a href="/alwayscodex.apk" download class="apk-banner-btn"><i class="fa-solid fa-download"></i> Download APK </a></div><div class="stats-grid mb-4"><div class="glass-card stat-card"><div class="stat-card-left"><span class="stat-card-label">Server Status</span><p class="stat-card-value text-success" id="stat-server-status">Online</p><span class="stat-card-desc">Status Server</span></div><div class="stat-card-right"><i class="fa-solid fa-server"></i></div></div><div class="glass-card stat-card"><div class="stat-card-left"><span class="stat-card-label">Total Users</span><p class="stat-card-value" id="stat-total-users">--</p><span class="stat-card-desc">Total Pengguna</span></div><div class="stat-card-right"><i class="fa-solid fa-users"></i></div></div><div class="glass-card stat-card"><div class="stat-card-left"><span class="stat-card-label">Your Credits</span><p class="stat-card-value" id="stat-your-credits">--</p><span class="stat-card-desc">Sisa Credits Anda</span><span class="stat-card-reset" id="stat-credits-reset-countdown" style="font-size: 0.75rem; color: #94a3b8; margin-top: 4px; display: block;">Reset: --:--:--</span></div><div class="stat-card-right"><i class="fa-solid fa-bolt"></i></div></div><div class="glass-card stat-card"><div class="stat-card-left"><span class="stat-card-label">Berhasil Terbuat</span><p class="stat-card-value" id="stat-total-requests">0</p><span class="stat-card-desc">Total Berhasil Terbuat (Semua Pengguna)</span></div><div class="stat-card-right"><i class="fa-solid fa-circle-check" style="color: #10b981;"></i></div></div><div class="glass-card stat-card"><div class="stat-card-left"><span class="stat-card-label">Baterai HP</span><p class="stat-card-value" id="stat-battery">--</p><span class="stat-card-desc" id="stat-battery-status">Membaca data...</span></div><div class="stat-card-right"><i class="fa-solid fa-battery-three-quarters" id="stat-battery-icon"></i></div></div><div class="glass-card stat-card"><div class="stat-card-left"><span class="stat-card-label">Hari</span><p class="stat-card-value" id="stat-day">--</p><span class="stat-card-desc" id="stat-date">Membaca tanggal...</span></div><div class="stat-card-right"><i class="fa-solid fa-calendar-day"></i></div></div><div class="glass-card stat-card"><div class="stat-card-left"><span class="stat-card-label">Your IP</span><p class="stat-card-value" id="stat-your-ip" style="font-size: 1.15rem; word-break: break-all;">Loading...</p><span class="stat-card-desc">Alamat IP Anda</span></div><div class="stat-card-right"><i class="fa-solid fa-network-wired"></i></div></div><div class="glass-card stat-card"><div class="stat-card-left"><span class="stat-card-label">Runtime</span><p class="stat-card-value" id="stat-runtime" style="font-size: 1.15rem;">--:--:--</p><span class="stat-card-desc">Waktu Aktif Server</span></div><div class="stat-card-right"><i class="fa-solid fa-stopwatch"></i></div></div><div class="glass-card stat-card"><div class="stat-card-left"><span class="stat-card-label">Contact Owner</span><p class="stat-card-value" style="font-size: 1.1rem;"><a href="https://wa.me/6288297563383" target="_blank" style="color: inherit; text-decoration: none; display: flex; align-items: center; gap: 5px;"><i class="fa-brands fa-whatsapp" style="color: #25d366;"></i> WhatsApp</a></p><span class="stat-card-desc">6288297563383</span></div><div class="stat-card-right"><i class="fa-solid fa-headset"></i></div></div></div></section><section id="screen-generator" class="screen hidden"><div class="dashboard-header animate-fade-in" style="margin-bottom: 28px; border-bottom: 1px solid var(--border-color); padding-bottom: 16px;"><h2 class="section-title" style="font-size: 1.85rem; display: flex; align-items: center; gap: 12px; margin: 0;"><i class="fa-solid fa-wand-magic-sparkles" style="color: var(--accent-primary);"></i> Create Account</h2><p class="section-subtitle" style="margin-top: 6px; font-size: 0.88rem; line-height: 1.6; max-width: 700px; color: var(--text-secondary);">Kirim tautan verifikasi email Alight Motion dan aktifkan status langganan premium secara instan.</p></div><div class="generator-box glass-card animate-fade-in"><div class="panel-header-desc"><h2 class="card-title"><i class="fa-solid fa-wand-magic-sparkles"></i> Alight Motion Premium License</h2><span id="badge-admin-control" class="badge badge-admin hidden"><i class="fa-solid fa-circle-check"></i> Admin Mode Enabled</span></div><div class="tab-switcher" style="display: flex; gap: 10px; margin-bottom: 25px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px; overflow-x: auto;"><button class="tab-btn active" id="tab-btn-manual" style="padding: 10px 18px; border-radius: var(--radius-sm); border: none; background: var(--accent-primary); color: white; font-weight: 600; cursor: pointer; transition: all 0.2s ease; display: flex; align-items: center; gap: 8px; white-space: nowrap;"><i class="fa-solid fa-wand-magic-sparkles"></i> Manual Generator</button><button class="tab-btn" id="tab-btn-auto" style="padding: 10px 18px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background: transparent; color: var(--text-muted); font-weight: 600; cursor: pointer; transition: all 0.2s ease; display: flex; align-items: center; gap: 8px; white-space: nowrap;"><i class="fa-solid fa-bolt"></i> Auto Generator (Otomatis)</button></div><div id="tab-manual-content" class="activation-flow"><div class="flow-box"><h3><i class="fa-solid fa-envelope-circle-check"></i> Masukkan Email Target</h3><p class="step-desc">Masukkan alamat email Alight Motion target Anda. Server akan mengirimkan pesan verifikasi lisensi ke email tersebut.</p><form id="form-send-link"><div class="input-group"><i class="fa-solid fa-at input-icon"></i><input type="email" id="send-email" placeholder="nama@email.com" required></div><button type="submit" id="btn-send-link" class="btn btn-primary btn-glow"><span class="btn-text">Lanjutkan <i class="fa-solid fa-arrow-right"></i></span><span class="btn-spinner hidden"><i class="fa-solid fa-spinner fa-spin"></i> Memproses...</span></button></form></div><div id="stage-activate-container" class="flow-box mt-4 hidden animate-fade-in"><h3><i class="fa-solid fa-link"></i> Tempel Tautan Verifikasi</h3><p class="step-desc">Buka pesan di email target (cek folder spam jika perlu), salin tautan tombol verifikasi, dan tempelkan di bawah ini.</p><form id="form-activate"><div class="input-group"><i class="fa-solid fa-at input-icon"></i><input type="email" id="activate-email" placeholder="Email target" required readonly></div><div class="input-group"><i class="fa-solid fa-link input-icon"></i><input type="url" id="activate-link" placeholder="https://alightcreative.com/..." required></div><button type="submit" id="btn-activate" class="btn btn-primary"><span class="btn-text">Terapkan Lisensi Premium <i class="fa-solid fa-bolt"></i></span><span class="btn-spinner hidden"><i class="fa-solid fa-spinner fa-spin"></i> Memverifikasi...</span></button></form></div></div><div id="tab-auto-content" class="activation-flow hidden"><div id="autogen-locked-container" class="flow-box text-center" style="padding: 40px 20px;"><i class="fa-solid fa-lock text-accent" style="font-size: 3rem; color: #f59e0b; margin-bottom: 20px;"></i><h3 style="font-weight: 700; font-size: 1.3rem;">Fitur Auto Generator Terkunci</h3><p class="step-desc" style="max-width: 500px; margin: 10px auto 25px;"> Fitur ini memungkinkan pembuatan akun Alight Motion premium secara 100% otomatis menggunakan server kotak masuk terintegrasi. Anda tidak perlu lagi menyalin dan menempel tautan verifikasi. </p><div class="price-badge" style="background: #fffbeb; border: 1px solid #fde68a; color: #d97706; padding: 10px 20px; border-radius: var(--radius-sm); display: inline-block; font-weight: 700; margin-bottom: 25px;"> Harga: Rp 7.000 / Bulan (Sekali Jalan Maksimal 500 Akun) </div><br><button id="btn-buy-autogen-shortcut" class="btn btn-primary" style="background: #10b981 !important; border-color: #10b981 !important; font-weight: 600;"><i class="fa-solid fa-cart-shopping"></i> Beli Paket Sekarang</button></div><div id="autogen-unlocked-container" class="flow-box hidden"><h3><i class="fa-solid fa-bolt"></i> Mulai Generator Otomatis</h3><p class="step-desc">Tentukan jumlah akun yang ingin dibuat (maksimal 500), pilih domain email, lalu klik Mulai. Akun akan dibuat dan diaktifkan secara berurutan.</p><div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: var(--radius-sm); padding: 15px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;"><div><span style="font-weight: 600; color: #475569; font-size: 0.9rem;">Kapasitas Pembuatan:</span><span class="badge badge-normal" style="font-weight: 700; background: #e2e8f0; color: #475569;">Maksimal 500 Akun / Batch</span></div><span class="badge badge-premium" style="background: #fffbeb; color: #d97706; border: 1px solid #fde68a;"><i class="fa-solid fa-circle-check"></i> Paket Aktif</span></div><form id="form-autogen-start" style="margin-bottom: 25px;"><div style="display: flex; align-items: center; gap: 8px; margin-bottom: 15px;"><input type="checkbox" id="autogen-custom-toggle" style="width: 16px; height: 16px; cursor: pointer;"><label for="autogen-custom-toggle" style="font-size: 0.88rem; font-weight: 600; color: var(--text-primary); cursor: pointer; user-select: none; display: flex; align-items: center; gap: 6px;"><i class="fa-solid fa-signature" style="color: var(--accent-primary);"></i> Gunakan Nama Custom (Email Custom) </label></div><div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;"><div id="autogen-prefix-container" class="input-group hidden" style="flex-grow: 2; margin: 0; min-width: 200px;"><i class="fa-solid fa-user-tag input-icon" style="color: var(--text-muted); z-index: 10;"></i><input type="text" id="autogen-prefix-input" placeholder="Nama email (Contoh: rehanprem)" style="width: 100%; border: 1px solid #cbd5e1; border-radius: var(--radius-sm); padding: 12px 16px 12px 40px; background: white; font-family: inherit; font-size: 0.95rem; outline: none;"></div><div class="input-group" style="flex-grow: 2; margin: 0; min-width: 200px;"><i class="fa-solid fa-globe input-icon" style="color: var(--text-muted); z-index: 10;"></i><select id="autogen-domain-select" required style="width: 100%; border: 1px solid #cbd5e1; border-radius: var(--radius-sm); padding: 12px 16px 12px 40px; background: white; font-family: inherit; font-size: 0.95rem; cursor: pointer; outline: none;"><option value="" disabled selected>Memuat daftar domain...</option></select></div><div id="autogen-count-container" class="input-group" style="flex-grow: 1; margin: 0; max-width: 160px; min-width: 120px;"><i class="fa-solid fa-calculator input-icon" style="color: var(--text-muted); z-index: 10;"></i><input type="number" id="autogen-count-input" min="1" max="500" value="5" required placeholder="Jumlah" style="width: 100%; border: 1px solid #cbd5e1; border-radius: var(--radius-sm); padding: 12px 16px 12px 40px; background: white; font-family: inherit; font-size: 0.95rem; outline: none; text-align: center;"></div><button type="submit" id="btn-autogen-run" class="btn btn-primary btn-glow" style="min-width: 180px; height: 48px;"><span class="btn-text"><i class="fa-solid fa-circle-play"></i> Mulai Generate</span><span class="btn-spinner hidden"><i class="fa-solid fa-spinner fa-spin"></i> Menghubungkan...</span></button></div></form><div id="autogen-hud" class="hidden" style="margin-top: 15px; margin-bottom: 15px; background: #0f172a; border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem; color: #f8fafc; font-family: inherit; flex-wrap: wrap; gap: 10px;"><div style="display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-spinner fa-spin" style="color: #38bdf8;"></i><span>Sisa Antrean: <strong id="autogen-hud-remaining" style="color: #38bdf8;">0</strong> / <span id="autogen-hud-total">0</span> Akun</span></div><div style="display: flex; align-items: center; gap: 8px;"><i class="fa-regular fa-clock" style="color: #10b981;"></i><span>Estimasi Selesai: <strong id="autogen-hud-eta" style="color: #10b981;">0s</strong></span></div></div><div id="autogen-log-container" class="hidden" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: #0f172a; padding: 20px; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #f8fafc; max-height: 250px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px;"><div style="color: #64748b;">[SYSTEM] Logger diinisialisasi...</div></div><div id="autogen-download-area" class="hidden" style="margin-top: 15px; display: flex; justify-content: flex-end;"><button id="btn-autogen-download" class="btn btn-secondary" style="border: 1px solid #10b981; color: #10b981; background: transparent; font-weight: 600; display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: var(--radius-sm); cursor: pointer; transition: all 0.2s ease;"><i class="fa-solid fa-download"></i> Download Hasil (.txt) </button></div></div></div></div></section><section id="screen-history" class="screen hidden"><div class="dashboard-h